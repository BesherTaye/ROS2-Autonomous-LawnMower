          </box>
        </geometry>
      </visual>

    </link>
  </model>


  <!-- Internal obstacle 2 -->
  <model name="box_2">
    <static>true</static>

    <pose>-1.5 -1.0 0.5 0 0 0</pose>

    <link name="link">

