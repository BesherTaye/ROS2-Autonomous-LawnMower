<?xml version="1.0"?>

<robot name="my_robot">

  <!-- ==================== -->
  <!-- Main robot body      -->
  <!-- ==================== -->

  <link name="base_link">

    <visual>
      <geometry>
        <box size="0.6 0.4 0.2"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <box size="0.6 0.4 0.2"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="5.0"/>

      <inertia
        ixx="0.1167"
        ixy="0.0"
        ixz="0.0"
        iyy="0.1833"
        iyz="0.0"
        izz="0.2833"/>
    </inertial>

  </link>


  <!-- ==================== -->
  <!-- Left wheel           -->
  <!-- ==================== -->

  <link name="left_wheel">

    <visual>

      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>

    </visual>

    <collision>

      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>

    </collision>

  </link>


  <!-- ==================== -->
  <!-- Left wheel joint     -->
  <!-- ==================== -->

  <joint name="left_wheel_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="left_wheel"/>

    <origin xyz="0 0.225 -0.05"
            rpy="1.5708 0 0"/>

    <axis xyz="0 0 1"/>

  </joint>

  <!-- ==================== -->
  <!-- Right wheel          -->
  <!-- ==================== -->

  <link name="right_wheel">

    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
    </collision>

  </link>

  <!-- ==================== -->
  <!-- Right wheel joint    -->
  <!-- ==================== -->

  <joint name="right_wheel_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="right_wheel"/>

    <origin xyz="0 -0.225 -0.05"
            rpy="1.5708 0 0"/>

    <axis xyz="0 0 1"/>

  </joint>

</robot>
